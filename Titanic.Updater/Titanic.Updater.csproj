<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net20;net35;net40;net45;net48;net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <IsTrimmable>false</IsTrimmable>

        <PackageId>Titanic.Updater</PackageId>
        <Authors>jvyden</Authors>
        <Description>Updater library for old osu! clients that use the Titanic custom servers</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/osuTitanic/titanic-csharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/osuTitanic/titanic-csharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeVendoredSharpZipLibInPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <PropertyGroup>
        <!-- .NET Framework builds intentionally uses a modified version of SharpZipLib that legacy osu! clients use. -->
        <VendoredSharpZipLibPath>$(MSBuildThisFileDirectory)Dependencies\Titanic.ICSharpCode.SharpZipLib.dll</VendoredSharpZipLibPath>
    </PropertyGroup>

    <ItemGroup>
        <!-- Do not let ResolveAssemblyReference treat the vendored DLL as a generic candidate. -->
        <None Remove="Dependencies\Titanic.ICSharpCode.SharpZipLib.dll" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net20' or '$(TargetFramework)' == 'net35' or '$(TargetFramework)' == 'net40' or '$(TargetFramework)' == 'net45' or '$(TargetFramework)' == 'net48'">
        <Reference Include="Titanic.ICSharpCode.SharpZipLib">
            <HintPath>$(VendoredSharpZipLibPath)</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
    </ItemGroup>

    <Target Name="IncludeVendoredSharpZipLibInPackage"
            Condition="'$(TargetFramework)' == 'net20' or '$(TargetFramework)' == 'net35' or '$(TargetFramework)' == 'net40' or '$(TargetFramework)' == 'net45' or '$(TargetFramework)' == 'net48'">
        <ItemGroup>
            <BuildOutputInPackage Include="$(VendoredSharpZipLibPath)">
                <FinalOutputPath>$(VendoredSharpZipLibPath)</FinalOutputPath>
                <TargetPath>Titanic.ICSharpCode.SharpZipLib.dll</TargetPath>
            </BuildOutputInPackage>
        </ItemGroup>
    </Target>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Titanic.API\Titanic.API.csproj" />
      <ProjectReference Include="..\Titanic.Helpers\Titanic.Helpers.csproj" />
    </ItemGroup>

</Project>
